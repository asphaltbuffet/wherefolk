# Secrets and per-host settings for deploy/compose.yaml.
#
# Never commit real values. The Operator keeps the real file in agenix and runs
#   docker compose -f deploy/compose.yaml --env-file /run/agenix/wherefolk-env up -d
# (docs/operations/deployment.md). deploy/.env is gitignored for the case where
# a file is used in place.

# Tailscale OAuth client secret with the node settings appended. Create the
# client in the admin console with the "Auth Keys: Write" scope and
# tag:wherefolk. Keep "?ephemeral=false": an ephemeral node is deleted when it
# goes offline, and the Editor's bookmark stops resolving.
TS_AUTHKEY=tskey-client-REPLACE_ME?ephemeral=false&preauthorized=true

# Encrypts every Full-tier export. At least 8 characters, no surrounding
# whitespace. Empty leaves the Full tier unavailable. Single-quote the value if
# it contains a $, or compose will try to interpolate it.
WHEREFOLK_FULL_PASSPHRASE=

# The wherefolk image tag to run. Pin it (for example 1.4.0) to roll back; note
# that an older binary refuses a document written by a newer schema.
WHEREFOLK_VERSION=latest
